# Cloudflare Workers — not used by Vercel.
wrangler.toml
wrangler.jsonc
cloudflare/
.wranglerignore

# Most API routes run on AWS Lambda (see vercel.json rewrites).
# Whitelist OTP mail handlers so Vercel serverless can use SES Mail Manager SMTP.
api/*
!api/send-mail.ts
!api/auth/
!api/lib/
!api/types/

aws/
