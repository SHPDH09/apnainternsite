# Cloudflare Workers — not used by Vercel.
wrangler.toml
wrangler.jsonc
cloudflare/
.wranglerignore

# Most API routes run on AWS Lambda (see vercel.json rewrites).
# Whitelist OTP mail handlers + their RDS/SMTP dependencies.
api/**
!api/send-mail.ts
!api/otp-deliver.ts
!api/request-otp.ts
!api/auth/forgot-password.ts
!api/rds-portal.ts
!api/auth-portal.ts
!api/db-ping.ts
!api/.bundled/**
# Do not whitelist api/lib/** — each api/*.ts becomes a serverless function (Hobby max 12).
# Mail handlers bundle lib/* at build time via imports.
# Never whitelist api/blog-interaction.ts or api/blogEngagementVercel.ts — breaks Vercel deploy.

aws/*
!aws/server
!aws/server/**
