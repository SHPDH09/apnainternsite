# Cloudflare Workers — not used by Vercel.
wrangler.toml
wrangler.jsonc
cloudflare/
.wranglerignore

# Most API routes run on AWS Lambda (see vercel.json rewrites).
# Whitelist OTP mail handlers + their RDS/SMTP dependencies.
api/**
!api/send-mail.ts
!api/otp-deliver.ts
!api/request-otp.ts
!api/auth/forgot-password.ts
!api/admin-partner-register.ts
!api/partner-application-submit.ts
!api/ensure-partner-applications.ts
!api/ensure-project-report-templates.ts
!api/ensure-staff-attendance-offices.ts
!api/staff-office-rpc.ts
!api/staffOfficeSqlChunks.ts
!api/staffOfficeApply.ts
!api/rds-apply-all.ts
!api/rest/**
!api/auth/**
!api/storage/**
!api/lib/**
# Never whitelist api/blog-interaction.ts or api/blogEngagementVercel.ts — breaks Vercel deploy.

aws/**
!aws/server/**
!aws/scripts/81-rds-staff-salary-account.sql
!aws/scripts/86-rds-staff-salary-advanced.sql
!aws/scripts/83-rds-staff-attendance-offices-admin-rpc.sql
!aws/scripts/85-rds-staff-attendance-offices-ensure-schema.sql
!aws/scripts/87-rds-staff-attendance-offices-all-admin-rpc-fix.sql
