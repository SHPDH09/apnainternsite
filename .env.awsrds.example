# ─────────────────────────────────────────────────────────────────────────────
# AWS RDS LOCAL — copy to `.env.awsrds.local` then:
#   npm run dev                    # API :3000 + Vite :8080 (one command)
#   # or separately:
#   npm run aws:api                # Express → RDS + auth/rest/storage shim
#   npm run dev:frontend:awsrds    # Vite :8080 (proxies to :3000)
#
# Browser never hits *.supabase.co — all auth, tables, RPCs, storage → RDS + S3.
# ─────────────────────────────────────────────────────────────────────────────

# Option A — full URL (staging RDS ap-south-1):
DATABASE_URL=postgresql://ezyintern:PASSWORD@ezyintern-staging-db.c5makww6eq8y.ap-south-1.rds.amazonaws.com:5432/ezyintern?sslmode=require

# Option B — parts (script builds the URL):
# AWS_RDS_HOST=ezyintern-staging-db.c5makww6eq8y.ap-south-1.rds.amazonaws.com
# AWS_RDS_USER=ezyintern
# AWS_RDS_PASSWORD=YOUR_PASSWORD
# AWS_RDS_DATABASE=ezyintern
# AWS_RDS_PORT=5432

# Mumbai (current live staging) — use as SOURCE for region migration:
# AWS_RDS_HOST=ezyintern-staging-db.c5makww6eq8y.ap-south-1.rds.amazonaws.com
# AWS_RDS_USER=ezyintern
# AWS_RDS_DATABASE=ezyintern

# Hyderabad (new cluster) — TARGET; run once: npm run aws:rds:migrate-region
# TARGET_DATABASE_URL=postgresql://postgres:PASSWORD@database-1.cluster-cpy4aaca6mfv.ap-south-2.rds.amazonaws.com:5432/ezyintern?sslmode=require
# AWS_RDS_TARGET_HOST=database-1.cluster-cpy4aaca6mfv.ap-south-2.rds.amazonaws.com
# AWS_RDS_TARGET_USER=postgres
# AWS_RDS_TARGET_PASSWORD=YOUR_PASSWORD
# AWS_RDS_TARGET_DATABASE=ezyintern

# Local shim (Vite proxies /auth /rest /storage /api → Express :3000)
VITE_SUPABASE_URL=http://localhost:8080
VITE_SUPABASE_PUBLISHABLE_KEY=local-anon-key
VITE_SUPABASE_PROJECT_ID=ezyintern-local
LOCAL_SUPABASE=true
LOCAL_JWT_SECRET=change-me-local-secret
RDS_RPC_OPEN=true

VITE_SITE_API_ORIGIN=http://localhost:8080
VITE_PUBLIC_APP_URL=http://localhost:8080

# Razorpay TEST keys for staging (public key for checkout UI)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxx

# ── Amazon SES SMTP (required for Comms, OTP, registration emails) ──
# SMTP_USER=AKIAxxxxxxxx
# SMTP_PASS=your-ses-smtp-password
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# MAIL_FROM=Apna Intern <noreply@apnaintern.in>
# MAIL_FROM_ADDRESS=noreply@apnaintern.in
# SES_REGION=ap-south-1
#
# SES sandbox: verify sender AND each test recipient in AWS Console, or run:
#   node aws/scripts/ses-verify-email.mjs you@example.com

# S3 staging buckets (after npm run aws:s3:provision + aws:s3:sync)
# S3_BUCKET_CONSENT_FORMS=ezyintern-staging-consent-forms
# S3_BUCKET_LOGOS=ezyintern-staging-logos
# S3_BUCKET_LEARNING_MATERIALS=ezyintern-staging-learning-materials
# S3_BUCKET_ASSIGNMENT_UPLOADS=ezyintern-staging-learning-materials
# AWS_DEFAULT_REGION=ap-south-1
# VITE_S3_PUBLIC_BASE_URL=https://ezyintern-staging-consent-forms.s3.ap-south-1.amazonaws.com

# ── WA CRM (official WhatsApp Cloud API — server-side secrets only) ──
# WA_CRM_DEMO_MODE=true
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WABA_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# OPENAI_API_KEY=   # optional AI provider
# GEMINI_API_KEY=   # optional AI provider (uses existing /api/gemini-generate when wired)
