{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "SMTP_HOST": "brua3gww2w8z.fips.wmjb.mail-manager-smtp.amazonaws.com",
    "SMTP_USER": "inp-3u5sedrqj7kqwjazxwmph2th",
    "SMTP_PORT": "587",
    "USE_SES_API": "false",
    "MAIL_FROM_ADDRESS": "info@apnaintern.in",
    "SMTP_PASS": "Raunak@12583"
  },
  "redirects": [
    {
      "source": "/cyber-cafe/login",
      "destination": "/cybercafe/login",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "popups"
        }
      ],
      "destination": "/admin/popups",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/((?!send-mail$|request-otp$|auth/forgot-password$).*)",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/api/$1"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/auth/:path*"
    },
    {
      "source": "/rest/:path*",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/rest/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/storage/:path*"
    },
    {
      "source": "/functions/:path*",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/functions/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}