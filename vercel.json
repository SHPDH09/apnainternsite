{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/cyber-cafe/login",
      "destination": "/cybercafe/login",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [{ "type": "query", "key": "tab", "value": "popups" }],
      "destination": "/admin/popups",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/((?!send-mail$|auth/forgot-password$).*)",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/api/$1"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/auth/:path*"
    },
    {
      "source": "/rest/:path*",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/rest/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/storage/:path*"
    },
    {
      "source": "/functions/:path*",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/functions/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
