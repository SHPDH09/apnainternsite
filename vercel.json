{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/rds-portal.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "api/.bundled/**,aws/server/sql/**"
    },
    "api/send-mail.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/auth-portal.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/otp-deliver.ts": {
      "maxDuration": 60
    },
    "api/request-otp.ts": {
      "maxDuration": 60
    },
    "api/auth/forgot-password.ts": {
      "maxDuration": 60
    },
    "api/admin-blog-posts.ts": {
      "maxDuration": 60
    },
    "api/admin-blog-leads.ts": {
      "maxDuration": 60
    },
    "api/ensure-blog-cms.ts": {
      "maxDuration": 60
    },
    "api/vercel-storage.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/db-ping.ts": {
      "maxDuration": 30
    }
  },
  "env": {
    "VITE_SUPABASE_URL": "https://apnaintern.in",
    "VITE_SUPABASE_PROJECT_ID": "hflapipozwwwinbbfpuh",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "local-anon-key",
    "LOCAL_SUPABASE": "true",
    "RDS_IAM_AUTH": "false",
    "RDS_RPC_OPEN": "true"
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.ezyintern.in" }],
      "destination": "https://apnaintern.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ezyintern.in" }],
      "destination": "https://apnaintern.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.apnaintern.in" }],
      "destination": "https://apnaintern.in/:path*",
      "permanent": true
    },
    {
      "source": "/cyber-cafe/login",
      "destination": "/cybercafe/login",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "popups"
        }
      ],
      "destination": "/admin/popups",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/public/blog-media",
      "destination": "/api/send-mail"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/auth-portal?path=$1"
    },
    {
      "source": "/rest/(.*)",
      "destination": "/api/rds-portal?segment=rest&path=$1"
    },
    {
      "source": "/storage/(.*)",
      "destination": "/api/vercel-storage?path=$1"
    },
    {
      "source": "/((?!api/|assets/|rest/|auth/|storage/|realtime/|functions/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
