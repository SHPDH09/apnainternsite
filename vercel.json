{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/send-mail.ts": {
      "maxDuration": 60,
      "includeFiles": [
        "server/blogEngagementVercel.ts",
        "api/lib/blogMediaUpload.ts"
      ]
    },
    "api/auth/forgot-password.ts": {
      "maxDuration": 60,
      "includeFiles": [
        "server/blogEngagementVercel.ts",
        "api/lib/useRds.ts",
        "api/lib/otpMailTemplate.ts",
        "api/lib/smtpErrors.ts"
      ]
    },
    "api/admin-partner-register.ts": {
      "maxDuration": 60,
      "includeFiles": [
        "api/lib/**",
        "aws/server/db.ts",
        "aws/server/partner-applications-bootstrap.ts"
      ]
    },
    "api/ensure-partner-applications.ts": {
      "maxDuration": 60,
      "includeFiles": [
        "api/lib/verifyBearerSession.ts",
        "aws/server/local-jwt.ts",
        "aws/server/partner-applications-bootstrap.ts",
        "aws/server/db.ts"
      ]
    },
    "api/ensure-project-report-templates.ts": {
      "maxDuration": 60,
      "includeFiles": [
        "api/lib/verifyBearerSession.ts",
        "aws/server/local-jwt.ts",
        "aws/server/project-report-bootstrap.ts",
        "aws/server/db.ts"
      ]
    },
    "api/partner-application-submit.ts": {
      "maxDuration": 60,
      "includeFiles": [
        "aws/server/local-jwt.ts",
        "aws/server/partner-applications-bootstrap.ts",
        "aws/server/db.ts"
      ]
    },
    "api/staff-office-rpc.ts": {
      "maxDuration": 60,
      "includeFiles": [
        "api/staffOfficeApply.ts",
        "api/staffOfficeSqlChunks.ts"
      ]
    }
  },
  "env": {
    "SMTP_HOST": "smtp.hostinger.com",
    "SMTP_USER": "info@apnaintern.in",
    "SMTP_PORT": "587",
    "SMTP_PASS": "Raunak@12583",
    "USE_SES_API": "true",
    "USE_SES_FOR_BULK": "true",
    "MAIL_FROM": "Apna Intern <info@apnaintern.in>",
    "MAIL_FROM_ADDRESS": "info@apnaintern.in",
    "AWS_ACCESS_KEY_ID": "AKIAUP3VMJBI563S3RNY",
    "AWS_SECRET_ACCESS_KEY": "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",
    "AWS_DEFAULT_REGION": "ap-south-1",
    "SES_REGION": "ap-south-1"
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.ezyintern.in" }],
      "destination": "https://apnaintern.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ezyintern.in" }],
      "destination": "https://apnaintern.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.apnaintern.in" }],
      "destination": "https://apnaintern.in/:path*",
      "permanent": true
    },
    {
      "source": "/cyber-cafe/login",
      "destination": "/cybercafe/login",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "popups"
        }
      ],
      "destination": "/admin/popups",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/((?!send-mail$|otp-deliver$|request-otp$|auth/forgot-password$|admin-partner-register$|partner-application-submit$|ensure-partner-applications$|ensure-project-report-templates$|ensure-staff-attendance-offices$|staff-office-rpc$|rds-apply-all$).*)",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/api/$1"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/auth/:path*"
    },
    {
      "source": "/rest/:path*",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/rest/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/storage/:path*"
    },
    {
      "source": "/functions/:path*",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/functions/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}