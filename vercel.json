{
  "functions": {
    "api/send-bulk-mail.ts": {
      "maxDuration": 60
    },
    "api/send-mail.ts": {
      "maxDuration": 60
    },
    "api/gemini-generate.ts": {
      "maxDuration": 60
    },
    "api/razorpay-recovery.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/cyber-cafe/login",
      "destination": "/cybercafe/login",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [{ "type": "query", "key": "tab", "value": "popups" }],
      "destination": "/admin/popups",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
