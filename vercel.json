{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "VITE_SUPABASE_URL": "https://apnaintern.in",
    "VITE_SUPABASE_PROJECT_ID": "hflapipozwwwinbbfpuh"
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.ezyintern.in" }],
      "destination": "https://apnaintern.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ezyintern.in" }],
      "destination": "https://apnaintern.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.apnaintern.in" }],
      "destination": "https://apnaintern.in/:path*",
      "permanent": true
    },
    {
      "source": "/cyber-cafe/login",
      "destination": "/cybercafe/login",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "popups"
        }
      ],
      "destination": "/admin/popups",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/public/blog-media",
      "destination": "/api/send-mail"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://hflapipozwwwinbbfpuh.supabase.co/auth/$1"
    },
    {
      "source": "/rest/(.*)",
      "destination": "https://hflapipozwwwinbbfpuh.supabase.co/rest/$1"
    },
    {
      "source": "/storage/(.*)",
      "destination": "https://hflapipozwwwinbbfpuh.supabase.co/storage/$1"
    },
    {
      "source": "/realtime/(.*)",
      "destination": "https://hflapipozwwwinbbfpuh.supabase.co/realtime/$1"
    },
    {
      "source": "/((?!api/|assets/|rest/|auth/|storage/|realtime/|functions/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
